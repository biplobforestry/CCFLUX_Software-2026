# --- Python virtual environments (created by the launchers, ~400 MB each) ---
.venv/
.venv-macos/
.venv-windows/
venv/
env/

# --- Python build / bytecode artefacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Test / type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Runtime output: generated per flight, never source ---
logs/
outputs/
*.jsonl
*.ccflux

# --- OS and editor cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
